{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ENS-Table",
  "version": "0.1.1",
  "identifier": "ru.ens-office.table",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "ENS-Table", "width": 1280, "height": 820, "minWidth": 640, "minHeight": 400 }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
