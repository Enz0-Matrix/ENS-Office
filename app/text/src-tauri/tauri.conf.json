{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ENS-Tekst",
  "version": "0.1.0",
  "identifier": "ru.ens-office.text",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5174",
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ENS-Tekst",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 400,
        "decorations": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "publisher": "ENS-Office",
    "copyright": "© Н. Едренников, ENS-Office",
    "shortDescription": "ENS-Tekst — текстовый редактор ENS-Office",
    "fileAssociations": [
      {
        "ext": [
          "docx"
        ],
        "name": "Документ Word",
        "description": "Документ Word",
        "role": "Editor",
        "mimeType": "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "languages": [
          "Russian"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/header.bmp",
        "sidebarImage": "installer/sidebar.bmp"
      }
    }
  }
}